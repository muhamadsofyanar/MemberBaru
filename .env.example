# Local development: use localhost instead of postgres in DATABASE_URL.
DATABASE_URL="postgresql://postgres:CHANGE_ME@postgres:5432/rizqhub?schema=public"
POSTGRES_PASSWORD="CHANGE_ME"
AUTH_SECRET=""
NEXT_PUBLIC_APP_URL="https://app.rizqhub.id"
PRIVATE_STORAGE_DIR="/app/storage/private"
ADMIN_EMAIL="admin@rizqhub.id"
ADMIN_PASSWORD=""

# SMTP required for self-service password reset.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Optional order status notifications.
STARSENDER_API_URL=""
STARSENDER_API_KEY=""
STARSENDER_DEVICE_ID=""
