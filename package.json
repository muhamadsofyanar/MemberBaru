{
  "name": "rizqhub-membership",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test:deployment": "node --test tests/deployment-source.test.mjs",
    "lint": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --import tsx prisma/seed.ts",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "admin:init": "node --import tsx scripts/init-admin.ts",
    "starter:import": "node --import tsx scripts/import-starter.ts"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "bcryptjs": "3.0.2",
    "jose": "6.1.0",
    "lucide-react": "0.544.0",
    "next": "15.5.25",
    "nodemailer": "^10.0.9",
    "react": "19.1.7",
    "react-dom": "19.1.7",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "prisma": "6.16.2",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.4",
    "effect": "^3.20.0",
    "deepmerge-ts": "8.0.2"
  }
}
